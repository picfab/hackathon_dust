# DatoCMS Content Delivery API — Read-only token
# https://<your-project>.admin.datocms.com/project_settings/api-tokens
DATOCMS_API_TOKEN=your_read_only_token_here

# Inclure les brouillons (X-Include-Drafts). false en production.
DATOCMS_INCLUDE_DRAFTS=false

# Amplitude Dashboard REST API (région EU) — board /amplitude
AMPLITUDE_API_KEY=your_amplitude_api_key
AMPLITUDE_SECRET_KEY=your_amplitude_secret_key
# Optionnel (valeurs par défaut) :
# AMPLITUDE_LEAD_EVENT=lead_generated
# AMPLITUDE_PAGE_PROPERTY=[Amplitude] Page Path

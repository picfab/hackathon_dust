---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import SeoPreview from '../../components/SeoPreview.astro';
import { Image } from '@datocms/astro/Image';
import { StructuredText } from '@datocms/astro/StructuredText';
import { getArticleBySlug } from '../../lib/queries';
import { DATOCMS_INCLUDE_DRAFTS } from 'astro:env/server';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const article = await getArticleBySlug(slug);

if (!article) {
  return Astro.rewrite('/404');
}

const dateSource = article._publishedAt ?? article._createdAt;
const date = dateSource
  ? new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(
      new Date(dateSource),
    )
  : null;

const dateFmt = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Paris',
});
const timeFmt = new Intl.DateTimeFormat('fr-FR', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Europe/Paris',
});
const updated = article._updatedAt ? new Date(article._updatedAt) : null;
const updatedStr = updated ? `${dateFmt.format(updated)} à ${timeFmt.format(updated)}` : null;

const heroTitle = article.hero?.title ?? article.slug;
const responsiveImage = article.hero?.image?.responsiveImage ?? null;
---

<Layout seoMetaTags={article.seo}>
  <article>
    <!-- Hero -->
    <header class="relative overflow-hidden bg-cream">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -left-24 -top-24 h-80 w-80 rounded-full bg-brand-300/40 blur-[120px]"></div>
        <div class="absolute -right-16 top-10 h-72 w-72 rounded-full bg-gold-400/25 blur-[120px]"></div>
      </div>

      <div class="relative mx-auto max-w-3xl px-6 pb-12 pt-16 text-center md:pt-20">
        <a
          href="/#articles"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 transition-colors hover:text-brand-700"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Tous les articles
        </a>
        {date && <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-brand-500">{date}</p>}
        {updatedStr && (
          <p class="mt-1 text-xs font-medium text-ink-400">Mis à jour le {updatedStr}</p>
        )}
        <h1 class="mt-3 text-4xl font-bold leading-[1.1] text-ink-900 md:text-6xl">
          {heroTitle}
        </h1>
      </div>
    </header>

    {
      responsiveImage && (
        <div class="mx-auto -mb-16 max-w-5xl px-6">
          <Image
            data={responsiveImage}
            pictureClass="block overflow-hidden rounded-[var(--radius-card)] shadow-[var(--shadow-lift)] ring-1 ring-ink-900/5"
            imgClass="w-full"
            sizes="(min-width: 1024px) 1024px, 100vw"
            priority
          />
        </div>
      )
    }

    <!-- Body -->
    <div class={`mx-auto max-w-2xl px-6 pb-24 ${responsiveImage ? 'pt-28' : 'pt-14'}`}>
      {DATOCMS_INCLUDE_DRAFTS && (
        <div class="mb-10">
          <SeoPreview seo={article.seo} url={Astro.url} />
        </div>
      )}

      <div class="prose">
        {article.content.map((block) => <StructuredText data={block.content} />)}
      </div>

      <div class="mt-16 rounded-[var(--radius-card)] bg-ink-900 p-10 text-center text-white">
        <h2 class="text-2xl font-bold text-white md:text-3xl">Prêt à simplifier votre gestion RH ?</h2>
        <p class="mx-auto mt-3 max-w-md text-white/60">
          Découvrez comment PayFit accompagne les équipes au quotidien.
        </p>
        <div class="mt-6 flex justify-center">
          <Button href="/#articles">Demander une démo</Button>
        </div>
      </div>
    </div>
  </article>
</Layout>

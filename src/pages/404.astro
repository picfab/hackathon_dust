---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title="Page introuvable — PayFit">
  <section class="relative overflow-hidden bg-cream">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute left-1/4 top-0 h-80 w-80 rounded-full bg-brand-300/40 blur-[120px]"></div>
      <div class="absolute right-1/4 bottom-0 h-72 w-72 rounded-full bg-gold-400/25 blur-[120px]"></div>
    </div>

    <div class="relative mx-auto flex max-w-2xl flex-col items-center px-6 py-32 text-center">
      <span class="font-display text-8xl font-bold text-brand-500 md:text-9xl">404</span>
      <h1 class="mt-4 text-3xl font-bold text-ink-900 md:text-4xl">Cette page n'existe pas</h1>
      <p class="mt-4 max-w-md text-lg text-ink-500">
        Le contenu que vous cherchez a peut-être été déplacé ou n'a jamais existé.
      </p>
      <div class="mt-8">
        <Button href="/">Retour à l'accueil</Button>
      </div>
    </div>
  </section>
</Layout>

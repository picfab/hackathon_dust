---
const columns = [
  { title: 'Produit', items: ['Fonctionnalités', 'Tarifs', 'Sécurité', 'Intégrations'] },
  { title: 'Ressources', items: ['Articles', 'Guides', 'Webinaires', 'Aide'] },
  { title: 'Entreprise', items: ['À propos', 'Carrières', 'Presse', 'Contact'] },
];
---

<footer class="bg-ink-900 text-white">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-500 text-white" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M5 19V5h7a4.5 4.5 0 0 1 0 9H9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="font-display text-xl font-bold">PayFit</span>
        </div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/60">
          La plateforme qui simplifie la gestion de vos équipes, de la paie aux ressources humaines.
        </p>
      </div>

      {
        columns.map((col) => (
          <div>
            <h4 class="text-sm font-semibold text-white">{col.title}</h4>
            <ul class="mt-4 space-y-3">
              {col.items.map((item) => (
                <li>
                  <a href="/#articles" class="text-sm text-white/60 transition-colors hover:text-white">
                    {item}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 sm:flex-row">
      <p class="text-sm text-white/50">© 2026 PayFit. Tous droits réservés.</p>
      <div class="flex gap-4 text-white/50">
        <a href="/#articles" aria-label="LinkedIn" class="transition-colors hover:text-white">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.6 8.65 22 10.3 22 13.6V21h-4v-6.5c0-1.55-.03-3.54-2.16-3.54-2.16 0-2.49 1.69-2.49 3.43V21H9V9Z"/></svg>
        </a>
        <a href="/#articles" aria-label="Twitter" class="transition-colors hover:text-white">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.5 8.6L23 22h-6.9l-5.4-7-6.2 7H1.4l8-9.2L1 2h7l4.9 6.5L18.9 2Zm-2.4 18h1.9L7.6 4H5.6l10.9 16Z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

---
import Button from './Button.astro';

const links = [
  { label: 'Articles', href: '/#articles' },
  { label: 'Produit', href: '/#articles' },
  { label: 'Tarifs', href: '/#articles' },
  { label: 'Ressources', href: '/#articles' },
];
---

<header
  class="sticky top-0 z-50 border-b border-ink-900/5 bg-white/80 backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-6">
    <a href="/" class="flex items-center gap-2.5">
      <span
        class="grid h-9 w-9 place-items-center rounded-xl bg-brand-500 text-white shadow-[0_6px_16px_rgba(108,92,231,0.4)]"
        aria-hidden="true"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M5 19V5h7a4.5 4.5 0 0 1 0 9H9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="font-display text-xl font-bold tracking-tight text-ink-900">PayFit</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-full px-4 py-2 text-sm font-medium text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-600"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href="/#articles"
        class="hidden rounded-full px-4 py-2 text-sm font-semibold text-ink-700 transition-colors hover:text-brand-600 sm:inline-flex"
      >
        Se connecter
      </a>
      <Button href="/#articles">Demander une démo</Button>
    </div>
  </nav>
</header>
